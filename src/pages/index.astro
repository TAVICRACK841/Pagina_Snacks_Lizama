---
import Auth from '../components/Auth';
import WelcomeBrand from '../components/WelcomeBrand';
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Snacks Lizama - Bienvenido</title>
  </head>
  
  {/* CAMBIO AQUÍ: Fondo Negro/Oscuro con un degradado sutil */}
  <body class="min-h-screen bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-gray-900 via-black to-black flex flex-col items-center justify-center p-4">
    
    <div class="w-full max-w-md space-y-6 animate-fade-in flex flex-col items-center">
      
      {/* Componente del Logo */}
      <WelcomeBrand client:load />

      {/* Formulario de Auth */}
      <Auth client:load />

      <div class="text-center mt-8">
        <p class="text-white/40 text-xs">© 2026 Snacks Lizama.</p>
      </div>

    </div>

  </body>
</html>